# Copy this file to e2e/.env and fill in real UAT credentials.
# Never commit e2e/.env (it is gitignored).

# App URL — must match vite.config.js (port 3000)
E2E_BASE_URL=http://localhost:3000

# Login credentials (UAT / train only)
E2E_USERNAME=your_username
E2E_PASSWORD=your_password

# Outlet site code OR visible outlet label (either works)
E2E_OUTLET=your_outlet_code_or_label

# GTO destination store label (must differ from E2E_OUTLET)
E2E_TO_OUTLET=another_outlet_label

# HQ branch label (optional — PR approve / GTI docs capture only)
E2E_HQ_OUTLET=

# --- Posting workflow (creates real documents; clean up via DB after) ---
# Item code that exists and can be received at this outlet
E2E_ITEM_CODE=your_item_code
# Optional overrides
E2E_SUPPLIER=
E2E_ITEM_QTY=1
E2E_ITEM_PRICE=1
E2E_TERM=30
# Required only if BATCH_NO is enabled (keep short, max ~10 chars)
E2E_BATCH_NO=E2E01

# Set to 1 if the app is already running
# E2E_SKIP_WEBSERVER=1

# Set to 1 to run Dragon-specific Stock Take + GTI docs capture (docs-stocktake-gti.spec.js)
# E2E_RUN_STOCKTAKE_GTI=0
