# Copy this file to e2e/.env and fill in real UAT credentials.
# Never commit e2e/.env (it is gitignored).

# App URL — must match vite.config.js (port 3000)
E2E_BASE_URL=http://localhost:3000

# Login credentials (UAT / train only)
E2E_USERNAME=your_username
E2E_PASSWORD=your_password

# Must match login dropdown label (e.g. "BeautySalon HQ - Demo"), not an old site code
E2E_OUTLET=your_outlet_label_from_login_dropdown

# GTO destination store label (must differ from E2E_OUTLET)
E2E_TO_OUTLET=another_outlet_label

# HQ branch label (required for batch-fefo PR approve test)
E2E_HQ_OUTLET=

# LoopBack GET for post-run verification (default: zenthtrain train API)
E2E_API_BASE_URL=https://zenthtrain.beautecloud.com/lb/api

# post-all outbound batch mode: specific (default) | fefo
E2E_OUTBOUND_BATCH_MODE=specific

# Set to 1 to run e2e/workflows/batch-fefo-post.spec.js
E2E_RUN_BATCH_FEFO=0

# ZE train full UAT (PR 2-line + SUM/GTO/RTN/ADJ/GTI FEFO) — e2e/workflows/batch-ze-uat.spec.js
E2E_RUN_ZE_UAT=0
# Non-HQ PR → GRN on approve — e2e/workflows/pr-external-grn.spec.js
E2E_RUN_PR_EXTERNAL_GRN=0
# Four-case matrix (FEFO, specific, PR mixed, PR all-specific + external GRN post)
# Writes e2e/reports/matrix-*.md — e2e/workflows/batch-matrix-uat.spec.js
E2E_RUN_MATRIX_UAT=0
# Optional: label for Request To (else first non-HQ supplier in dropdown)
E2E_PR_EXTERNAL_SUPPLIER=
E2E_ITEM_CODE_2=

# --- Posting workflow (creates real documents; clean up via DB after) ---
# Item code that exists and can be received at this outlet
E2E_ITEM_CODE=your_item_code
# Optional overrides
E2E_SUPPLIER=
E2E_ITEM_QTY=1
E2E_ITEM_PRICE=1
E2E_TERM=30
# Required only if BATCH_NO is enabled (keep short, max ~10 chars)
E2E_BATCH_NO=E2E01

# Set to 1 if the app is already running
# E2E_SKIP_WEBSERVER=1

# Set to 1 to run Dragon-specific Stock Take + GTI docs capture (docs-stocktake-gti.spec.js)
# E2E_RUN_STOCKTAKE_GTI=0
